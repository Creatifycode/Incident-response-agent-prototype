# Hindsight Cloud - server-side only. Never expose to the browser.
HINDSIGHT_API_KEY=hsk_replace_me

# Hindsight Cloud base URL. Do not change unless self-hosting.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# The single memory bank holding organizational production experience.
HINDSIGHT_BANK_ID=prod-incident-memory

# Reflect is the expensive operation (agentic LLM loop).
# low = fast/shallow, mid = balanced, high = deep multi-source exploration.
HINDSIGHT_REFLECT_BUDGET=mid

# Recall grounding depth: low | mid | high
HINDSIGHT_RECALL_BUDGET=mid

# Token caps. Recall bills on the content it returns, so lower this first
# if you are credit constrained.
HINDSIGHT_RECALL_MAX_TOKENS=4096
HINDSIGHT_REFLECT_MAX_TOKENS=4096
